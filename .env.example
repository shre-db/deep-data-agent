# Model selection. Supported prefixes: empero:, openrouter:, openai:
# Examples:
#   MODEL=empero:glm-5.3-flash          (free, no key currently required)
#   MODEL=openrouter:z-ai/glm-5.3-flash (requires OPENROUTER_API_KEY)
#   MODEL=openai:gpt-4o-mini            (requires OPENAI_API_KEY)
MODEL=empero:glm-5.3-flash

# API keys (only needed for the selected provider)
EMPERO_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-data-agent
